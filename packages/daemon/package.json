{
  "name": "@anomander/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime: processors, providers, matter cycles, scheduler and migrations.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "eval:receipts": "node --env-file-if-exists=../../.env scripts/eval-receipts.ts",
    "eval:text": "node --env-file-if-exists=../../.env scripts/eval-text.ts"
  },
  "dependencies": {
    "@anomander/core": "workspace:*",
    "@anomander/protocol": "workspace:*",
    "@anomander/telegram": "workspace:*",
    "@earendil-works/pi-ai": "1.3.0",
    "better-sqlite3": "13.0.3",
    "croner": "10.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
