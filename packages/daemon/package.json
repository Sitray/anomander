{
  "name": "@anomander/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime: processors, providers, matter cycles, scheduler and migrations.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "eval:receipts": "node --env-file-if-exists=../../.env scripts/eval-receipts.ts",
    "eval:text": "node --env-file-if-exists=../../.env scripts/eval-text.ts",
    "login": "node --env-file-if-exists=../../.env scripts/login.ts",
    "logout": "node --env-file-if-exists=../../.env scripts/logout.ts"
  },
  "dependencies": {
    "@anomander/core": "workspace:*",
    "@anomander/protocol": "workspace:*",
    "@anomander/telegram": "workspace:*",
    "@earendil-works/pi-ai": "1.6.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "croner": "11.0.1",
    "pi-web-access": "0.48.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.2"
  }
}
