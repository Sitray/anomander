      "document": {
        "mcpServers": {
          "zeta": {
            "command": "x",
            "env": []
          }
        }
      },
      "valid": false,
      "at": "mcpServers.zeta.env",
      "daemonAt": ["mcpServers.zeta"]
    },
    {
      "name": "headers on a process server",
      "document": {
        "mcpServers": {
          "zeta": {
            "command": "x",
            "headers": {}
          }
        }
      },
      "valid": false,
      "at": "mcpServers.zeta.headers",
      "daemonAt": ["mcpServers.zeta"]
    },
    {
      "name": "env on an HTTP server",
      "document": {
        "mcpServers": {
          "alpha": {
            "url": "https://example.com/mcp",
            "env": {}
          }
        }
      },
      "valid": false,
      "at": "mcpServers.alpha.env",
      "daemonAt": ["mcpServers.alpha"]
    },
    {
      "name": "plain HTTP to another machine",
      "document": {
        "mcpServers": {
          "alpha": {
            "url": "http://example.com/mcp"
          }
        }
      },
      "valid": false,
      "at": "mcpServers.alpha.url",
      "daemonAt": ["mcpServers.alpha"]
    },
    {
      "name": "an empty read-only tool",
      "document": {
        "mcpServers": {
          "zeta": {
            "command": "x",
            "readOnly": [""]
          }
        }
      },
      "valid": false,
      "at": "mcpServers.zeta.readOnly",
      "daemonAt": ["mcpServers.zeta"]
    },
    {
      "name": "two wrong servers",
      "document": {
        "mcpServers": {
          "zeta": {
            "command": ""
          },
          "off": "x"
        }
      },
      "valid": false,
      "at": "mcpServers.zeta.command",
      "daemonAt": ["mcpServers.zeta", "mcpServers.off"]
