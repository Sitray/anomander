  ],
  "serverNames": {
    "valid": [
      "notes",
      "My notes 2.0",
      "a",
      "A_b-c.d",
      "0day",
      "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
