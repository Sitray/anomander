# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# The only chat the bot serves: the principal's Telegram user ID (R-1).
ANOMANDER_PRINCIPAL_CHAT_ID=

# SQLite file.
ANOMANDER_DB_PATH=./data/anomander.db
# Temporary folder for receipt images (R-8).
ANOMANDER_INBOX_DIR=./data/inbox
# Model logins made with /login in Telegram or `pnpm run login` (R-27). Holds tokens: mode 600.
ANOMANDER_AUTH_PATH=./data/auth.json

# Provider-qualified model IDs, for example openai/<model> or ollama/<model> (R-15).
ANOMANDER_MODEL=
ANOMANDER_VISION_MODEL=
# Model providers read their own API keys from the environment, for example:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# A subscription login (/login) needs no key here and takes precedence over that provider's key.

# Daily processor call cap (R-12).
ANOMANDER_DAILY_AI_CALL_LIMIT=200
# Timeout of each processor call, in seconds (R-22).
ANOMANDER_PROCESSOR_TIMEOUT_SECONDS=60
# Weekly summary schedule (R-10).
ANOMANDER_WEEKLY_SUMMARY_CRON=0 20 * * 0
# Retention job schedule (R-19).
ANOMANDER_RETENTION_CRON=0 3 * * *
# Time zone.
TZ=Europe/Madrid

# Read API (RA-2, docs/read-access-prd.md). Off while the token is empty: no port opens.
# Use a long random secret, for example `openssl rand -hex 32`; readers send it as a bearer token.
ANOMANDER_API_TOKEN=
# The address it binds to: the local machine unless you name a private network's address.
ANOMANDER_API_HOST=127.0.0.1
ANOMANDER_API_PORT=4311
