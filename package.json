{
  "name": "anomander",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout 30000",
    "eval:receipts": "pnpm -F @anomander/daemon eval:receipts",
    "eval:text": "pnpm -F @anomander/daemon eval:text",
    "login": "pnpm -F @anomander/daemon run login",
    "logout": "pnpm -F @anomander/daemon run logout"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
